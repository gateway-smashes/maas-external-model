# ---------------------------------------------------------------------------
# Copy to config.env and fill in.  Everything else in this folder reads these.
# ---------------------------------------------------------------------------

# Where the external model object lives
export MAAS_NS="maas-external-models"

# How the model appears in the OpenShift AI dashboard / playground
export MODEL_NAME="my-external-llm"                 # k8s name: lowercase, hyphens
export MODEL_DISPLAY_NAME="My External LLM"
export MODEL_DESCRIPTION="External OpenAI-compatible LLM fronted by MaaS"

# The upstream provider (OpenAI-compatible)
export PROVIDER_BASE_URL="https://llm.example.com/v1"   # MUST end in /v1
export PROVIDER_MODEL_ID="llama-3.3-70b-instruct"       # the id the PROVIDER expects
# Do not put comments on the same line as the key value.
export PROVIDER_API_KEY="changeme"
# Optional override: ExternalModel.spec.endpoint is FQDN only (derived from BASE_URL if unset)
# export PROVIDER_HOST="llm.example.com"

# If the provider uses a private/self-signed CA, put the PEM here (optional)
export PROVIDER_CA_BUNDLE_FILE=""

# ---------------------------------------------------------------------------
# Custom DNS (no wildcard on *.apps.<cluster-domain>)
# ---------------------------------------------------------------------------
# Your published base domain (NOT apps.<cluster>). Example: ai.example.com
export CUSTOM_DOMAIN="example.com"

# Required on this cluster for Routes to be admitted / published by the router.
# Space-separated key=value pairs, applied to the MaaS gateway Route.
# Example (this lab): export ROUTE_LABELS="ingress.k8s.bb/class=nginx"
export ROUTE_LABELS="ingress.k8s.bb/class=nginx"

# ---------------------------------------------------------------------------
# Two different "gateways" — do not conflate them
# ---------------------------------------------------------------------------
# 1) DASHBOARD (product GatewayConfig → Gateway/data-science-gateway):
#      https://openshift-ai.${CUSTOM_DOMAIN}   ← OpenShift AI UI
#    Managed by RHOAI (GatewayConfig/default-gateway). This repo does NOT
#    create/delete that Gateway. Leave it alone.
#
# 2) MaaS / inference (this repo → Gateway/maas-default-gateway):
#      https://maas.${CUSTOM_DOMAIN}          ← /maas-api + model chat
#    You NEED this second Gateway (+ Route). maas-ui discovers maas.<domain>
#    by default. Override MAAS_API_URL only if you change GATEWAY_HOSTNAME.
# ---------------------------------------------------------------------------
export GATEWAY_NS="maas-gateway"
export GATEWAY_NAME="maas-default-gateway"
# Empty => maas.${CUSTOM_DOMAIN} (preferred). Do NOT set this to the dashboard host.
export GATEWAY_HOSTNAME=""
# TLS Secret in GATEWAY_NS (script can copy from openshift-ingress when present)
export GATEWAY_CERT_SECRET="maas-gateway-tls"
export GATEWAY_CLASS="openshift-default"
export GATEWAY_ALLOWED_NAMESPACES="maas-gateway redhat-ods-applications maas-external-models models-as-a-service"
# Where Tenant deploys IPP (payload-processing). Usually same as GATEWAY_NS.
export IPP_NS="${GATEWAY_NS}"

# Optional: force dashboard maas-ui to this URL (defaults to https://$GATEWAY_HOSTNAME/maas-api)
# export MAAS_API_URL=""

# RHOAI namespaces
export APP_NS="redhat-ods-applications"
export OPERATOR_NS="redhat-ods-operator"
export TENANT_NS="models-as-a-service"
export TENANT_NAME="default-tenant"
