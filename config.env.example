# ---------------------------------------------------------------------------
# Copy to config.env and fill in.  Everything else in this folder reads these.
# ---------------------------------------------------------------------------

# Where the external model object lives
export MAAS_NS="maas-external-models"

# How the model appears in the OpenShift AI dashboard / playground
export MODEL_NAME="my-external-llm"                 # k8s name: lowercase, hyphens
export MODEL_DISPLAY_NAME="My External LLM"
export MODEL_DESCRIPTION="External OpenAI-compatible LLM fronted by MaaS"

# The upstream provider (OpenAI-compatible)
export PROVIDER_BASE_URL="https://llm.example.com/v1"   # MUST end in /v1
export PROVIDER_MODEL_ID="llama-3.3-70b-instruct"       # the id the PROVIDER expects
export PROVIDER_API_KEY="changeme"                      # provider-side key

# If the provider uses a private/self-signed CA, put the PEM here (optional)
export PROVIDER_CA_BUNDLE_FILE=""

# Your gateway (from your GatewayConfig)
export GATEWAY_NS="openshift-ingress"
export GATEWAY_NAME="data-science-gateway"

# Which MaaS tiers may call this model (space separated, case-sensitive)
export TIERS="free premium enterprise"

# RHOAI namespaces
export APP_NS="redhat-ods-applications"
export OPERATOR_NS="redhat-ods-operator"
